// Place your settings in this file to overwrite the default settings
{
    // Editor
    "editor.detectIndentation": true,
    "editor.insertSpaces": false,
    "editor.minimap.enabled": true,
    "editor.renderWhitespace": "all",
    "editor.tabSize": 4,
    "editor.guides.bracketPairs": true,
    "editor.guides.bracketPairsHorizontal": false,
    "editor.foldingStrategy": "indentation",
    // Files
    "files.trimTrailingWhitespace": true,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 3000,
    // Window
    "window.openFilesInNewWindow": "off",
    "window.newWindowDimensions": "maximized",
    "window.zoomLevel": -1,
    // Workbench
    "workbench.iconTheme": "vscode-icons",
    "workbench.editor.enablePreview": false,
    "workbench.startupEditor": "none",
    // Go
    "go.formatTool": "goimports",
    "go.lintTool": "golangci-lint",
    "go.toolsManagement.autoUpdate": true,
    "[go]": {
        "editor.formatOnSave": true
    },
    "gopls": {
        "build.buildFlags": ["-tags=integration"],
        "formatting.local": "bitbucket.org/your-org"
    },
    // Terminal
    "terminal.integrated.defaultProfile.osx": "fish",
    // Git tools
    "gitlens.currentLine.enabled": false,
    "gitProjectManager.openInNewWindow": true,
    "gitProjectManager.checkRemoteOrigin": false,
    "gitProjectManager.baseProjectsFolders": [
        "~/go/src/bitbucket.org"
    ],
    // Other tools
    "vsicons.dontShowNewVersionMessage": true,
    "redhat.telemetry.enabled": false,
    "security.workspace.trust.untrustedFiles": "open",
    "[markdown]": {
        "editor.wordWrap": "on"
    },
    "vs-kubernetes": {
        "vscode-kubernetes.kubectl-path.mac": "/Users/bertvanpoecke/.vs-kubernetes/tools/kubectl/kubectl",
        "vscode-kubernetes.minikube-path.mac": "/Users/bertvanpoecke/.vs-kubernetes/tools/minikube/darwin-amd64/minikube"
    },
    "diffEditor.ignoreTrimWhitespace": false
}