// Place your settings in this file to overwrite the default settings
{
    // Editor
    "editor.detectIndentation": true,
    "editor.insertSpaces": false,
    "editor.minimap.enabled": true,
    "editor.renderWhitespace": "all",
    "editor.tabSize": 4,
    "editor.guides.bracketPairs": true,
    "editor.guides.bracketPairsHorizontal": false,
    "editor.foldingStrategy": "indentation",
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 3000,
    // Window
    "window.openFilesInNewWindow": "off",
    "window.newWindowDimensions": "maximized",
    // Workbench
    "workbench.iconTheme": "vscode-icons",
    "workbench.startupEditor": "none",
    // Go
    "go.formatTool": "goimports",
    "go.lintTool": "golangci-lint",
    "go.toolsManagement.autoUpdate": true,
    "[go]": {
        "editor.formatOnSave": true
    },
    "gopls": {
        "build.buildFlags": ["-tags=integration"]
    },
    // Terminal
    "terminal.integrated.defaultProfile.osx": "zsh",
    // Git tools
    "gitlens.currentLine.enabled": false,
    "gitProjectManager.openInNewWindow": true,
    "gitProjectManager.checkRemoteOrigin": false,
    "gitProjectManager.baseProjectsFolders": [
        "~/go/src/bitbucket.org"
    ],
    // Other tools
    "vsicons.dontShowNewVersionMessage": true,
    "redhat.telemetry.enabled": false,
    "security.workspace.trust.untrustedFiles": "open",
    "[markdown]": {
        "editor.wordWrap": "on"
    },
    "diffEditor.ignoreTrimWhitespace": false,
    "window.zoomLevel": -1,
    "editor.inlineSuggest.showToolbar": "always",
    "scm.experimental.showHistoryGraph": true,
    "inlineChat.experimental.textButtons": true,
    "[yaml]": {
        "diffEditor.ignoreTrimWhitespace": false,
    },
    "files.trimTrailingWhitespace": true,
    "docker.extension.enableComposeLanguageServer": false,
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "gitProjectManager.maxDepthRecursion": 2,
    "gitProjectManager.storeRepositoriesBetweenSessions": true,
    "claudeCode.preferredLocation": "sidebar",
    "chat.disableAIFeatures": true,
    "workbench.editor.enablePreview": false,
}